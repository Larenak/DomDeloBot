NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:8080
# HTTPS-адрес мини-приложения в MAX. Если пусто, используется HTTPS PUBLIC_BASE_URL.
MAX_MINI_APP_URL=
# Username бота с Mini App, зарегистрированным на платформе MAX. Без него отправляется обычная ссылка.
MAX_MINI_APP_BOT_USERNAME=
DATABASE_URL=postgres://domdelo:domdelo@postgres:5432/domdelo
POSTGRES_PASSWORD=

MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_DELIVERY_MODE=webhook
# Защита от случайного удаления production webhook при локальном polling.
MAX_POLLING_REMOVE_WEBHOOKS=false

S3_ENDPOINT=http://minio:9000
S3_REGION=ru-1
S3_BUCKET=domdelo
S3_ACCESS_KEY_ID=domdelo
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

SESSION_SECRET=
LOG_LEVEL=info
DEMO_MODE=true
STORAGE_MODE=postgres
