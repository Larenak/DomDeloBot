{
  "name": "@domdelo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "openapi:export": "tsx src/openapi-export.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@domdelo/config": "workspace:*",
    "@domdelo/contracts": "workspace:*",
    "@domdelo/domain": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.4",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@maxhub/max-bot-api": "0.3.1",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
